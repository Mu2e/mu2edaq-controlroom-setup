# Launcher settings template. Copy to sites/<yoursite>.env. Sourced by bash;
# machine-local overrides go in ~/.config/mu2edaq-remote-site/<yoursite>.env.

# Shown in launcher descriptions.
SITE_TITLE="Example remote control room"

# Kerberos identity and keytab. With SITE_KEYTAB empty, kinit asks for the
# principal's password; with both empty, plain kinit.
SITE_PRINCIPAL=""
SITE_KEYTAB=""

# Saved VNC password files ({account} and {session} are replaced). Empty:
# the viewer asks every time.
SITE_PASSWORD_FILE=""

# VNC viewer binary. Empty: vncviewer on PATH, or TigerVNC Viewer.app on
# macOS (needed there for view-only and password files).
SITE_VIEWER=""

# Launchers to make: session names (from controlroom.yaml or the overlay)
# and "nodes" for the DAQ machine picker.
SITE_LAUNCHERS="shift-main dcs-main"

# Optional: where mu2edaq-cluster-tools is checked out (default: next to
# controlroom-setup), and the ssh-selector host list.
# SITE_CLUSTER_TOOLS="$HOME/mu2edaq/mu2edaq-cluster-tools"
# SITE_DAQ_HOSTS="$HOME/.local/share/mu2edaq-cluster-tools/config/mu2e_daq.yaml"
