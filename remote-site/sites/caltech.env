# Launcher settings for the Caltech remote control room. Sourced by bash.
# Machine-local overrides go in ~/.config/mu2edaq-remote-site/caltech.env.

SITE_TITLE="Caltech ROC"

# Kerberos identity and keytab: deliberately not in git. Set them on the
# ROC computer in ~/.config/mu2edaq-remote-site/caltech.env:
#   SITE_PRINCIPAL="<the identity the DAQ coordinator authorized>"
#   SITE_KEYTAB="$HOME/.krb/<its keytab>"     # mode 600
# With neither set, kinit asks for a password.
SITE_PRINCIPAL=
SITE_KEYTAB=

# Saved VNC password files, one per session account, copied with the DAQ
# coordinator's OK (mode 600). Without one the viewer asks.
SITE_PASSWORD_FILE="$HOME/.vnc/{account}.passwd"

# VNC viewer. Empty: vncviewer on PATH, or TigerVNC Viewer.app on macOS.
# On novacr02 without TigerVNC, set in the local file:
#   SITE_VIEWER="$HOME/Documents/NovaCR/bin/vncviewer"   # RealVNC from NOvA
SITE_VIEWER=

# Launchers install.sh makes. trig-main is left out: the Caltech identity
# is not authorized as mu2etrig (2026-11-06).
SITE_LAUNCHERS="shift-main dcs-main cr01 cr02 cr03 cr04 cr05 cr06 nodes"
